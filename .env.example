# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required for Whisper (speech-to-text) and GPT (intent parsing)
OPENAI_API_KEY=sk-...

# Model used for intent parsing. GPT-4o gives best accuracy; gpt-3.5-turbo is cheaper.
LLM_MODEL=gpt-4o

# ─── Browser ─────────────────────────────────────────────────────────────────
# Port Chrome must be launched with --remote-debugging-port=<port>
CHROME_DEBUG_PORT=9222

# Set to "true" on headless servers where no GUI Chrome is running.
# The agent will launch its own headless Chromium instead of connecting over CDP.
BROWSER_LAUNCH=false

# Path to Chromium binary used in launch mode.
# Default: Playwright's cached Chromium at /root/.cache/ms-playwright/...
# CHROMIUM_EXEC=/root/.cache/ms-playwright/chromium-1194/chrome-linux/chrome

# ─── Voice ───────────────────────────────────────────────────────────────────
# Seconds of audio to capture per voice command
VOICE_RECORD_SECONDS=5

# ─── CRM ─────────────────────────────────────────────────────────────────────
# Base URL of your CRM (used for navigation actions)
CRM_BASE_URL=https://app.kapturecrm.com

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
